{
  "$schema": "../recipe.schema.json",
  "id": "hash-brown-casserole",
  "title": "Hash Brown Casserole",
  "category": "Entrees",
  "contributor": "Brenda Bradley",
  "preheatF": 350,
  "components": [
    {
      "name": null,
      "ingredients": [
        "2 lbs frozen hash browns",
        "1 can cream of mushroom soup",
        "8 oz sour cream",
        "1/2 tsp pepper",
        "2 cups cheddar cheese",
        "1 small onion, diced",
        "1 tsp salt",
        "1/4 cup margarine, cut into pieces"
      ],
      "directions": [
        "Grease a 9x13 pan.",
        "In a large bowl, stir together all ingredients except margarine.",
        "Spread mixture into the pan.",
        "Place margarine pieces on top of the potatoes.",
        "Bake at 350°F for 1 hour."
      ]
    }
  ],
  "notes": []
}
