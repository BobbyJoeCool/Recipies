{
  "$schema": "../recipe.schema.json",
  "id": "ham-balls",
  "title": "Ham Balls",
  "category": "Entrees",
  "contributor": "Grandma Lois",
  "preheatF": 350,
  "components": [
    {
      "name": "Ham Balls",
      "ingredients": [
        "1 lb ground smoked ham",
        "1 lb ground pork",
        "2 eggs",
        "1½ cups cracker crumbs"
      ],
      "directions": [
        "Mix all ball ingredients together.",
        "Form into balls and place in a baking pan."
      ]
    },
    {
      "name": "Sauce",
      "ingredients": [
        "1 cup brown sugar",
        "1 tbsp dry mustard",
        "1/2 cup vinegar",
        "1/2 cup water",
        "1 tbsp cornstarch",
        "1 can pineapple, drained"
      ],
      "directions": [
        "Mix all sauce ingredients together and pour over ham balls.",
        "Bake at 350°F for 90 minutes."
      ]
    }
  ],
  "notes": []
}
