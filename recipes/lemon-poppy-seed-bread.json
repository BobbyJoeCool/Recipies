  "contributor": "Grandma Evelyn Kahl",
  "preheatF": 350,
  "components": [
    {
      "name": null,
      "ingredients": [
        "1 pkg lemon cake mix",
        "1 pkg instant lemon pudding",
        "4 eggs",
        "1 cup water",
        "1/4 cup oil",
        "1/4 to 1/2 cup poppy seeds"
      ],
      "directions": [
