{
  "$schema": "../recipe.schema.json",
  "id": "lime-jello-salad",
  "title": "Lime Jello Salad",
  "category": "Soups, Salads & Veggies",
  "contributor": "Grandma Lois",
  "preheatF": null,
  "components": [
    {
      "name": null,
      "ingredients": [
        "1 (3 oz) pkg lime jello",
        "1 (20 oz) can undrained crushed pineapple",
        "8 oz cream cheese",
        "8 oz Cool Whip",
        "2/3 to 3/4 cup chopped celery"
      ],
      "directions": [
        "Heat crushed pineapple (with juice) and dissolve lime jello in it. Let cool.",
        "Beat cream cheese and Cool Whip together until smooth.",
        "Stir celery into the cream cheese mixture.",
        "Add cooled jello and pineapple mixture. Stir to combine.",
        "Refrigerate until set. Serve chilled."
      ]
    }
  ],
  "notes": []
}
