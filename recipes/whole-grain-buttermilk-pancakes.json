      "ingredients": [
        "2/3 cup whole wheat flour",
        "1 tbsp wheat germ",
        "1/4 cup oat bran",
        "1 tbsp cornmeal",
        "1 tbsp brown sugar",
        "1½ tsp baking powder",
        "1/4 tsp salt",
        "1/4 cup buttermilk",
        "2 eggs",
        "2 tbsp oil"
