{
  "$schema": "../recipe.schema.json",
  "id": "monster-cookies",
  "title": "Monster Cookies",
  "category": "Desserts",
  "contributor": "Brenda Bradley",
  "preheatF": 350,
  "components": [
    {
      "name": null,
      "ingredients": [
        "12 eggs",
        "2 lbs brown sugar",
        "4 cups sugar",
        "1 tbsp vanilla",
        "1 tbsp maple syrup",
        "8 tsp baking soda",
        "1 lb margarine",
        "3 lbs peanut butter",
        "18 cups oatmeal",
        "1 lb chocolate chips",
        "1 lb M&Ms"
      ],
      "directions": [
        "Mix all ingredients together until well combined.",
        "Drop by spoonfuls onto baking sheets.",
        "Bake at 350°F for 9–11 minutes or until done."
      ]
    }
  ],
  "notes": [
    "This is a very large batch. Recipe can be scaled down."
  ]
}
